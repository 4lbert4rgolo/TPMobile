rules_version = '2';

// Regras de segurança do TPMobile.
// Quem protege os dados é este arquivo (no servidor), não a tela do app.
//
// Perfis (campo "papel" em usuarios/{uid}):
//   pendente  - criou a conta e espera aprovação: não lê nada além do próprio cadastro
//   votante   - vota nas enquetes abertas e vê escalas publicadas
//   removido  - teve o acesso retirado: não lê nada
//   servo     - Servo Ministerial: ajusta enquetes, publicadores e escalas
//   admin     - Administrador (inclui os anciãos): tudo isso, mais aprovar usuários e definir perfis
//   anciao    - perfil antigo, vale como admin até o app regravar o cadastro como "admin"

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function cadastro() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function papel() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? cadastro().papel
        : 'nenhum';
    }

    function aprovado() {
      return logado() && papel() in ['votante', 'servo', 'anciao', 'admin'];
    }

    function organizador() {
      return logado() && papel() in ['servo', 'anciao', 'admin'];
    }

    function administrador() {
      return logado() && papel() in ['admin', 'anciao'];
    }

    function meuPublicadorId() {
      return cadastro().publicadorId;
    }

    // Cada pessoa cria o próprio cadastro:
    //  - com e-mail e senha: sempre como "pendente", até o administrador aprovar;
    //  - pelo link pessoal: como "votante", ligado ao publicador daquele link.
    // Só o administrador muda perfil e vínculo.
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || administrador());
      allow create: if logado()
        && request.auth.uid == uid
        && (
          (request.auth.token.firebase.sign_in_provider != 'anonymous'
            && request.resource.data.papel == 'pendente'
            && request.resource.data.publicadorId == null
            && request.resource.data.keys().hasOnly(['nome', 'email', 'papel', 'publicadorId', 'criadoEm']))
          ||
          (request.resource.data.papel == 'votante'
            && request.resource.data.keys().hasOnly(['nome', 'email', 'papel', 'publicadorId', 'conviteId', 'criadoEm'])
            && get(/databases/$(database)/documents/convites/$(request.resource.data.conviteId)).data.ativo == true
            && get(/databases/$(database)/documents/convites/$(request.resource.data.conviteId)).data.publicadorId == request.resource.data.publicadorId
            && get(/databases/$(database)/documents/convites/$(request.resource.data.conviteId)).data.nome == request.resource.data.nome)
        );
      // A própria pessoa só pode gravar o aceite do aviso de privacidade (data e versão).
      allow update: if administrador()
        || (logado() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['privacidadeAceitaEm', 'privacidadeVersao'])
            && request.resource.data.privacidadeAceitaEm is string
            && request.resource.data.privacidadeVersao is int);
      allow delete: if administrador();
    }

    // Link pessoal: o código secreto é o próprio id do documento.
    // Quem conhece o código abre só esse convite; ninguém consegue listar os convites.
    match /convites/{codigo} {
      allow get: if logado();
      allow list, write: if administrador();
    }

    // A lista de publicadores é só dos organizadores.
    // O votante lê apenas o próprio registro.
    match /publicadores/{id} {
      allow read: if organizador() || (aprovado() && id == meuPublicadorId());
      allow write: if organizador();
    }

    // Horários de costume de cada publicador (já vêm marcados nas novas enquetes).
    // O votante lê e grava só o próprio; os organizadores acessam todos.
    match /disponibilidadePadrao/{pubId} {
      allow read: if organizador() || (aprovado() && pubId == meuPublicadorId());
      allow write: if organizador()
        || (aprovado() && pubId == meuPublicadorId() && request.resource.data.publicadorId == pubId);
    }

    // Pontos e horários padrão.
    match /config/{doc} {
      allow read: if aprovado();
      allow write: if organizador();
    }

    // Auditoria: quem fez o quê. Cada um registra só em nome próprio (uid e nome conferidos)
    // e com a hora do servidor. Ninguém edita; só o administrador apaga (limpeza dos 3 meses).
    // Votantes só registram aceite de privacidade e pedidos de troca.
    match /auditoria/{id} {
      allow read: if organizador();
      allow create: if aprovado()
        && request.resource.data.keys().hasOnly(['area', 'acao', 'alvo', 'detalhe', 'enqueteId', 'uid', 'nome', 'papel', 'quando', 'quandoISO'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nome == cadastro().nome
        && request.resource.data.quando == request.time
        && request.resource.data.acao is string && request.resource.data.acao.size() <= 120
        && request.resource.data.detalhe is string && request.resource.data.detalhe.size() <= 600
        && (organizador() || request.resource.data.area in ['privacidade', 'trocas']);
      allow update: if false;
      allow delete: if administrador();
    }

    match /enquetes/{enqueteId} {
      // Rascunhos só os organizadores veem.
      allow read: if organizador()
        || (aprovado() && resource.data.status in ['aberta', 'fechada', 'publicada']);
      allow write: if organizador();

      // O votante só grava o próprio voto, e só com a votação aberta.
      match /votos/{pubId} {
        allow read: if organizador() || (aprovado() && pubId == meuPublicadorId());
        allow write: if organizador()
          || (aprovado()
              && pubId == meuPublicadorId()
              && request.resource.data.publicadorId == pubId
              && get(/databases/$(database)/documents/enquetes/$(enqueteId)).data.status == 'aberta');
        allow delete: if organizador();
      }

      // Pedidos de troca ("Preciso trocar"). A pessoa pede e cancela os próprios;
      // os organizadores veem todos e resolvem ou dispensam.
      match /trocas/{trocaId} {
        allow read: if organizador()
          || (aprovado() && resource.data.publicadorId == meuPublicadorId());
        allow create: if organizador()
          || (aprovado()
              && request.resource.data.publicadorId == meuPublicadorId()
              && request.resource.data.status == 'aberta'
              && trocaId.matches(meuPublicadorId() + '_.*'));
        allow update: if organizador()
          || (aprovado()
              && resource.data.publicadorId == meuPublicadorId()
              && request.resource.data.publicadorId == meuPublicadorId()
              && (
                (request.resource.data.status == 'cancelada'
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
                || (resource.data.status != 'aberta' && request.resource.data.status == 'aberta')
              ));
        allow delete: if organizador();
      }

      // A escala só aparece para os votantes depois de publicada.
      match /escala/{doc} {
        allow read: if organizador()
          || (aprovado()
              && resource.data.publicada == true
              && get(/databases/$(database)/documents/enquetes/$(enqueteId)).data.status == 'publicada');
        allow write: if organizador();
      }
    }
  }
}
